generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int             @id @default(autoincrement())
  email                  String          @unique
  password               String
  name                   String
  adminChats             Chat[]          @relation("AdminChats")
  sentMessages           ChatMessage[]   @relation("SentMessages")
  receivedFollowRequests FollowRequest[] @relation("ReceivedFollowRequest")
  sentFollowRequests     FollowRequest[] @relation("SentFollowRequest")
  posts                  Post[]
  participantChats       Chat[]          @relation("ChatParticipants")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  published Boolean  @default(false)
  authorId  Int
  createdAt DateTime @default(now()) @db.Date
  imageUrl  String?
  author    User     @relation(fields: [authorId], references: [id])
}

model FollowRequest {
  id         Int          @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FollowStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  receiver   User         @relation("ReceivedFollowRequest", fields: [receiverId], references: [id])
  sender     User         @relation("SentFollowRequest", fields: [senderId], references: [id])

  @@unique([senderId, receiverId, status])
  @@index([senderId])
  @@index([receiverId])
}

model Chat {
  id            Int           @id @default(autoincrement())
  name          String
  isGroupChat   Boolean       @default(false)
  lastMessageId Int?          @unique
  adminId       Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  admin         User?         @relation("AdminChats", fields: [adminId], references: [id])
  lastMessage   ChatMessage?  @relation("ChatLastMessage", fields: [lastMessageId], references: [id])
  messages      ChatMessage[] @relation("ChatMessages")
  participants  User[]        @relation("ChatParticipants")
}

model ChatMessage {
  id            Int      @id @default(autoincrement())
  senderId      Int
  content       String
  chatId        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageOf Chat?    @relation("ChatLastMessage")
  chat          Chat     @relation("ChatMessages", fields: [chatId], references: [id])
  sender        User     @relation("SentMessages", fields: [senderId], references: [id])
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
}
